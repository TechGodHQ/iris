{
  "name": "@techgodhq/iris-client",
  "version": "0.1.0",
  "description": "Generated TypeScript fetch client for Iris.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TechGodHQ/iris.git",
    "directory": "generated/ts-client"
  },
  "homepage": "https://github.com/TechGodHQ/iris",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit --pretty false",
    "build": "tsc --pretty false",
    "package:smoke": "node scripts/package-smoke.mjs",
    "acceptance": "npm run package:smoke",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "devDependencies": {
    "typescript": "5.9.2"
  }
}
